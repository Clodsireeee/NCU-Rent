PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ncu_rent"

# 前端網址(CORS 與登入後導回用)
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 (Google Cloud Console 建立「網頁應用程式」憑證)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
ALLOWED_EMAIL_DOMAIN=g.ncu.edu.tw

# JWT
JWT_SECRET=請改成長隨機字串
JWT_EXPIRES_IN=7d

# 管理員信箱(逗號分隔),可管理所有房源/評價
ADMIN_EMAILS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 部署:正式環境請設 NODE_ENV=production、TRUST_PROXY_HOPS=2
TRUST_PROXY_HOPS=1

# ===== AI(評論審核 + 校園消息標籤)=====
# 不設定也能運作:會改用關鍵字規則。設定後審核更懂語意、消息會有摘要與活動時間。
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
# 用 OpenAI 相容服務時:AI_PROVIDER=openai、AI_BASE_URL=https://api.openai.com/v1、AI_MODEL=<模型名稱>
AI_BASE_URL=
# 評論送出時是否呼叫 AI(off = 只用規則)
MODERATION_AI=on
# 租屋代理人與新生入學包用的模型(不填就用 AI_MODEL)。要更聰明可改 claude-sonnet-5-5,但費用較高
AGENT_MODEL=
# 代理人一次最多呼叫幾輪工具
AGENT_MAX_STEPS=8
# AI 使用次數上限(防止費用暴增):登入者每小時、訪客每小時(0 = 訪客不能用)、全站每天
AGENT_HOURLY_LIMIT=20
AGENT_GUEST_HOURLY_LIMIT=5
AGENT_DAILY_LIMIT=300

# ===== MCP 伺服器(/mcp)=====
# AI 助理回傳的房源連結使用的網址(不填就用 FRONTEND_URL)
PUBLIC_SITE_URL=
# 額外允許從瀏覽器連線 /mcp 的網站(逗號分隔);claude.ai 與 FRONTEND_URL 已預設允許
MCP_ALLOWED_ORIGINS=
MCP_RATE_LIMIT=60
# 幾個人檢舉就自動下架等審核
REPORT_THRESHOLD=3

# ===== Google Maps Platform(周邊美食)=====
# Google Cloud Console 啟用「Places API (New)」;建議限制此金鑰只能呼叫 Places API
GOOGLE_MAPS_API_KEY=
EATERY_RADIUS_M=1500

# ===== 爬蟲 =====
# 請填團隊信箱,讓學校網管有問題時聯絡得到你們
CRAWLER_CONTACT=
CRAWL_DELAY_MS=1500
# 地址轉座標:nominatim(免費,可永久保存)或 google(較準,需上面的金鑰)
GEOCODER=nominatim
# 雲端租屋網的學校代號(94 = 中央大學)。要加鄰近學校:打開 https://house.nfu.edu.tw/<學校代碼>,
# F12 → Network → Fetch/XHR → 點「house」→ Payload 裡 arrSchId 的數字,用逗號加在後面,例如 94,12
HOUSE_SCHOOL_IDS=94
# 鄰近學校只保留距離中大幾公里內的房源
NEARBY_RADIUS_KM=2.5
NEWS_KEEP_DAYS=365
