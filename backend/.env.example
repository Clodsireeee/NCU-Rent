PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ncu_rent"

# 前端網址(CORS 與登入後導回用)
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 (Google Cloud Console 建立「網頁應用程式」憑證)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
ALLOWED_EMAIL_DOMAIN=g.ncu.edu.tw

# JWT
JWT_SECRET=請改成長隨機字串
JWT_EXPIRES_IN=7d

# 管理員信箱(逗號分隔),可管理所有房源/評價
ADMIN_EMAILS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 部署:正式環境請設 NODE_ENV=production、TRUST_PROXY_HOPS=2
TRUST_PROXY_HOPS=1
