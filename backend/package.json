{
  "name": "ncu-rent-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "seed": "node scripts/seed.js",
    "smoke": "node scripts/smoke-test.js",
    "test": "node --test \"test/*.test.js\"",
    "sync:houses": "node scripts/sync-houses.js",
    "import:fire": "node scripts/import-fire-list.js",
    "sync:eateries": "node scripts/sync-eateries.js",
    "sync:news": "node scripts/sync-news.js",
    "sync:clubs": "node scripts/sync-clubs.js",
    "sync:all": "node scripts/sync-news.js && node scripts/sync-clubs.js && node scripts/sync-houses.js && node scripts/sync-eateries.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "zod": "^3.23.8",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=20"
  }
}
